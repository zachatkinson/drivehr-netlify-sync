{
  "name": "drivehr-netlify-sync",
  "version": "0.0.0-development",
  "description": "TypeScript-based Netlify serverless function that scrapes DriveHR job postings and syncs them to WordPress via webhooks",
  "main": "dist/functions/sync-jobs.mjs",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && find dist/functions -name '*.d.*' -delete",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "NODE_OPTIONS=\"--import tsx/esm\" eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "NODE_OPTIONS=\"--import tsx/esm\" eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "typecheck": "tsc --noEmit",
    "type-check": "pnpm typecheck",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "security": "pnpm audit --audit-level moderate",
    "security:high": "pnpm audit --audit-level high",
    "security:fix": "pnpm audit --fix",
    "security:prod": "pnpm audit --audit-level high --prod",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "clean": "rm -rf dist coverage docs",
    "docs": "typedoc",
    "docs:serve": "typedoc --watch",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "scrape-and-sync": "node dist/scripts/scrape-and-sync.js",
    "inspect-jobs": "tsx scripts/job-data-tools.mts",
    "inspect-test-data": "tsx scripts/inspect-test-data.mts",
    "browse-jobs": "tsx scripts/browse-job-data.mts",
    "scrape-live": "tsx scripts/live-scraper.mts",
    "compare-jobs": "tsx scripts/compare-job-data.mts",
    "validate-jobs": "tsx scripts/validate-job-data.mts",
    "test-wordpress-payload": "tsx scripts/test-wordpress-payload.mts",
    "coverage-report": "tsx scripts/coverage-report.mts",
    "codecov": "tsx scripts/codecov-cli.mts",
    "netlify:watch": "netlify watch",
    "netlify:logs": "netlify logs:function sync-jobs",
    "netlify:status": "netlify status",
    "netlify:open": "netlify open:site",
    "verify-config": "node scripts/verify-config.js",
    "monitor-deployment": "node scripts/monitor-deployment.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "cheerio": "^1.2.0",
    "node-fetch": "^3.3.2",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@types/node": "^24.13.3",
    "@types/node-fetch": "^2.6.13",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "netlify-cli": "^27.10.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "semantic-release": "^24.2.9",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "pnpm": {
    "overrides": {
      "tmp": ">=0.2.4",
      "vite@>=7.1.0 <=7.1.4": ">=7.1.5",
      "playwright@<1.55.1": ">=1.55.1",
      "vite@>=7.1.0 <=7.1.10": ">=7.1.11",
      "multiparty@<4.3.0": ">=4.3.0",
      "http-proxy-middleware@>=3.0.0 <3.0.7": ">=3.0.7 <4",
      "sharp@<0.35.0": ">=0.35.0",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "toml@<4.2.0": ">=4.2.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv"
      ]
    }
  }
}
